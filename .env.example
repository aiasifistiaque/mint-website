# Where the website lives (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://mintapp.shop

# The MINT app (the tenant panel): Log in, Create account and Dashboard links go here.
NEXT_PUBLIC_APP_URL=https://app.mintapp.shop

# The backend's root — the waitlist form posts to <api>/public/waitlist.
NEXT_PUBLIC_API_URL=https://api.mintapp.shop

# "true" once sign-ups are open: adds "Create account" next to "Join the waitlist".
NEXT_PUBLIC_SIGNUPS_OPEN=false
